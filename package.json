{
  "name": "rieltorie",
  "version": "0.1.0-beta",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "worker"
  ],
  "scripts": {
    "build": "tsx apps/site/build.ts",
    "dev:miniapp": "npm run dev --workspace=apps/miniapp",
    "dev:worker": "npm run dev --workspace=worker",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.15.0",
    "js-yaml": "^4.1.0"
  }
}
