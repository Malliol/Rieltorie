{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Theme",
  "type": "object",
  "required": ["name", "bg", "surface", "ink", "accent", "muted", "softAccent", "border", "display", "body", "radius", "unit", "ratio"],
  "properties": {
    "name":        { "type": "string" },
    "bg":          { "type": "string" },
    "surface":     { "type": "string" },
    "ink":         { "type": "string" },
    "accent":      { "type": "string" },
    "muted":       { "type": "string" },
    "softAccent":  { "type": "string" },
    "border":      { "type": "string" },
    "display":     { "type": "string" },
    "body":        { "type": "string" },
    "radius":      { "type": "number" },
    "unit":        { "type": "number" },
    "ratio":       { "type": "string" }
  }
}
